{% comment %}
  TCG Price Index Page Template
  PRISM - Price Index System for Market Intelligence

  Displays market indices, trends, and crystal neural network visualization
{% endcomment %}

{% layout 'theme' %}

{{ 'price-index.css' | asset_url | stylesheet_tag }}

<div class="page-width price-index">
  {% comment %} Page Header {% endcomment %}
  <header class="price-index__header">
    <div class="price-index__header-content">
      <h1 class="price-index__title">{{ page.title | default: 'TCG Price Index' }}</h1>
      <p class="price-index__subtitle">Real-time market intelligence for trading card games</p>
    </div>
    <div class="price-index__header-meta">
      {% comment %} Currency Toggle {% endcomment %}
      <div class="price-index__currency-toggle" data-currency-toggle>
        <span class="price-index__currency-label">Currency</span>
        <div class="price-index__currency-switch">
          <button type="button" class="price-index__currency-btn price-index__currency-btn--active" data-currency="GBP">£ GBP</button>
          <button type="button" class="price-index__currency-btn" data-currency="JPY">¥ JPY</button>
        </div>
      </div>

      {% comment %} Exchange Rate Display {% endcomment %}
      <div class="price-index__fx-rate" data-fx-rate>
        <span>FX:</span>
        <span class="price-index__fx-rate-value">--</span>
      </div>

      <span class="price-index__updated" data-last-updated>Loading...</span>
      <button type="button" class="price-index__refresh" data-refresh-btn title="Refresh data">
        <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18">
          <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd"/>
        </svg>
      </button>
    </div>
  </header>

  {% comment %} Index Summary Bar {% endcomment %}
  <section class="price-index__summary" data-summary-bar>
    <div class="price-index__summary-loading">
      <div class="price-index-spinner"></div>
      <span>Loading market data...</span>
    </div>

    <div class="price-index__summary-cards" data-summary-cards hidden>
      {% comment %} Cards populated by JavaScript {% endcomment %}
    </div>
  </section>

  {% comment %} Main Content Grid {% endcomment %}
  <div class="price-index__main">
    {% comment %} Left: Visualization / Chart {% endcomment %}
    <div class="price-index__visualization">
      {% comment %} View Toggle {% endcomment %}
      <div class="price-index__view-toggle" data-view-toggle>
        <button type="button" class="price-index__view-btn price-index__view-btn--active" data-view="crystal">
          <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
            <path d="M3 4a1 1 0 011-1h3a1 1 0 011 1v3a1 1 0 01-1 1H4a1 1 0 01-1-1V4zm9 0a1 1 0 011-1h3a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1V4zM3 12a1 1 0 011-1h3a1 1 0 011 1v4a1 1 0 01-1 1H4a1 1 0 01-1-1v-4zm9-1a1 1 0 00-1 1v4a1 1 0 001 1h3a1 1 0 001-1v-4a1 1 0 00-1-1h-3z"/>
          </svg>
          Heatmap
        </button>
        <button type="button" class="price-index__view-btn" data-view="chart">
          <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
            <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zm6-4a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zm6-3a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/>
          </svg>
          Chart
        </button>
        <button type="button" class="price-index__view-btn" data-view="table">
          <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
            <path fill-rule="evenodd" d="M5 4a3 3 0 00-3 3v6a3 3 0 003 3h10a3 3 0 003-3V7a3 3 0 00-3-3H5zm-1 9v-1h5v2H5a1 1 0 01-1-1zm7 1h4a1 1 0 001-1v-1h-5v2zm0-4h5V8h-5v2zM9 8H4v2h5V8z" clip-rule="evenodd"/>
          </svg>
          Table
        </button>
        <button type="button" class="price-index__view-btn" data-view="network">
          <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
            <path d="M10 3a1.5 1.5 0 110 3 1.5 1.5 0 010-3zM5 7a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm10 0a1.5 1.5 0 110 3 1.5 1.5 0 010-3zM5 14a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm10 0a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm-5-2a1.5 1.5 0 110 3 1.5 1.5 0 010-3z"/>
            <path d="M10 5.5l-4 3M10 5.5l4 3M5 10l5 3m5-3l-5 3M5 14l5-1.5m5 1.5l-5-1.5" stroke="currentColor" stroke-width="1" fill="none"/>
          </svg>
          Network
        </button>
      </div>

      {% comment %} Crystal Visualization Container {% endcomment %}
      <div class="price-index__crystal-view" data-crystal-view>
        <div class="price-index__crystal-container" data-crystal-container>
          <canvas data-crystal-canvas></canvas>
          <div class="price-index__crystal-loading">
            <div class="price-index-spinner price-index-spinner--large"></div>
            <span>Generating crystal lattice...</span>
          </div>
          <div class="price-index__crystal-tooltip" data-crystal-tooltip hidden>
            <div class="price-index__tooltip-name" data-tooltip-name></div>
            <div class="price-index__tooltip-set" data-tooltip-set></div>
            <div class="price-index__tooltip-price" data-tooltip-price></div>
            <div class="price-index__tooltip-secondary" data-tooltip-secondary hidden></div>
            <div class="price-index__tooltip-change" data-tooltip-change></div>
          </div>
        </div>
        <div class="price-index__heatmap-legend">
          <span class="price-index__heatmap-legend-value">-10%</span>
          <div class="price-index__heatmap-scale">
            <div class="price-index__heatmap-scale-segment price-index__heatmap-scale-segment--loss-4"></div>
            <div class="price-index__heatmap-scale-segment price-index__heatmap-scale-segment--loss-3"></div>
            <div class="price-index__heatmap-scale-segment price-index__heatmap-scale-segment--loss-2"></div>
            <div class="price-index__heatmap-scale-segment price-index__heatmap-scale-segment--loss-1"></div>
            <div class="price-index__heatmap-scale-segment price-index__heatmap-scale-segment--neutral"></div>
            <div class="price-index__heatmap-scale-segment price-index__heatmap-scale-segment--gain-1"></div>
            <div class="price-index__heatmap-scale-segment price-index__heatmap-scale-segment--gain-2"></div>
            <div class="price-index__heatmap-scale-segment price-index__heatmap-scale-segment--gain-3"></div>
            <div class="price-index__heatmap-scale-segment price-index__heatmap-scale-segment--gain-4"></div>
          </div>
          <span class="price-index__heatmap-legend-value">+10%</span>
          <span class="price-index__heatmap-legend-label">24h Change</span>
        </div>
      </div>

      {% comment %} Chart View Container {% endcomment %}
      <div class="price-index__chart-view" data-chart-view hidden>
        <div class="price-index__chart-header">
          <select class="price-index__chart-select" data-chart-index>
            <option value="GAME_onepiece">One Piece Index</option>
            <option value="TOP_100">Top 100 Index</option>
          </select>
          <div class="price-index__chart-range" data-chart-range>
            <button type="button" class="price-index__range-btn" data-range="7">7D</button>
            <button type="button" class="price-index__range-btn price-index__range-btn--active" data-range="30">30D</button>
            <button type="button" class="price-index__range-btn" data-range="90">90D</button>
            <button type="button" class="price-index__range-btn" data-range="365">1Y</button>
          </div>
        </div>
        <div class="price-index__chart-container" data-chart-container>
          <canvas data-chart-canvas></canvas>
        </div>
        <div class="price-index__chart-stats" data-chart-stats>
          <div class="price-index__stat">
            <span class="price-index__stat-label">High</span>
            <span class="price-index__stat-value" data-stat-high>--</span>
          </div>
          <div class="price-index__stat">
            <span class="price-index__stat-label">Low</span>
            <span class="price-index__stat-value" data-stat-low>--</span>
          </div>
          <div class="price-index__stat">
            <span class="price-index__stat-label">Average</span>
            <span class="price-index__stat-value" data-stat-avg>--</span>
          </div>
          <div class="price-index__stat">
            <span class="price-index__stat-label">Volatility</span>
            <span class="price-index__stat-value" data-stat-volatility>--</span>
          </div>
        </div>
      </div>

      {% comment %} Table View Container {% endcomment %}
      <div class="price-index__table-view" data-table-view hidden>
        {% comment %} Table populated by JavaScript {% endcomment %}
      </div>

      {% comment %} Network View Container {% endcomment %}
      <div class="price-index__network-view" data-network-view hidden>
        <div class="price-index__network-container" data-network-container>
          <canvas data-network-canvas></canvas>
          <div class="price-index__network-loading">
            <div class="price-index-spinner price-index-spinner--large"></div>
            <span>Building correlation network...</span>
          </div>
          <div class="price-index__network-tooltip" data-network-tooltip hidden>
            <div class="price-index__tooltip-name" data-network-tooltip-name></div>
            <div class="price-index__tooltip-connections" data-network-tooltip-connections></div>
            <div class="price-index__tooltip-correlation" data-network-tooltip-correlation></div>
          </div>
        </div>
        <div class="price-index__network-legend">
          <div class="price-index__network-legend-title">Network Legend</div>
          <div class="price-index__network-legend-item">
            <span class="price-index__network-legend-node price-index__network-legend-node--large"></span>
            <span>High Market Cap</span>
          </div>
          <div class="price-index__network-legend-item">
            <span class="price-index__network-legend-node price-index__network-legend-node--small"></span>
            <span>Low Market Cap</span>
          </div>
          <div class="price-index__network-legend-item">
            <span class="price-index__network-legend-edge price-index__network-legend-edge--strong"></span>
            <span>Strong Correlation (>0.7)</span>
          </div>
          <div class="price-index__network-legend-item">
            <span class="price-index__network-legend-edge price-index__network-legend-edge--weak"></span>
            <span>Weak Correlation (0.3-0.7)</span>
          </div>
        </div>
        <div class="price-index__network-stats" data-network-stats>
          <div class="price-index__network-stat">
            <span class="price-index__network-stat-label">Total Nodes</span>
            <span class="price-index__network-stat-value" data-network-nodes>--</span>
          </div>
          <div class="price-index__network-stat">
            <span class="price-index__network-stat-label">Connections</span>
            <span class="price-index__network-stat-value" data-network-edges>--</span>
          </div>
          <div class="price-index__network-stat">
            <span class="price-index__network-stat-label">Avg Correlation</span>
            <span class="price-index__network-stat-value" data-network-avg-correlation>--</span>
          </div>
          <div class="price-index__network-stat">
            <span class="price-index__network-stat-label">Clusters</span>
            <span class="price-index__network-stat-value" data-network-clusters>--</span>
          </div>
        </div>
      </div>
    </div>

    {% comment %} Right: Control Panel {% endcomment %}
    <aside class="price-index__panel">
      {% comment %} Market Health Widget {% endcomment %}
      <div class="price-index__market-health" data-market-health>
        <div class="price-index__health-header">
          <h3 class="price-index__health-title">Market Health</h3>
          <span class="price-index__health-sentiment price-index__health-sentiment--neutral">
            ● Loading...
          </span>
        </div>
        <div class="price-index__movers-loading">
          <div class="price-index-spinner"></div>
        </div>
      </div>

      {% comment %} Game Filter {% endcomment %}
      <div class="price-index__filter-group">
        <label class="price-index__filter-label">Game</label>
        <select class="price-index__filter-select" data-game-filter>
          <option value="onepiece" selected>One Piece</option>
          <option value="pokemon" disabled>Pokemon (Coming Soon)</option>
        </select>
      </div>

      {% comment %} Set Filter {% endcomment %}
      <div class="price-index__filter-group">
        <label class="price-index__filter-label">Set</label>
        <select class="price-index__filter-select" data-set-filter>
          <option value="">All Sets</option>
        </select>
      </div>

      {% comment %} Rarity Filter {% endcomment %}
      <div class="price-index__filter-group">
        <label class="price-index__filter-label">Rarity</label>
        <select class="price-index__filter-select" data-rarity-filter>
          <option value="">All Rarities</option>
          <option value="L">Leader (L)</option>
          <option value="SEC">Secret Rare (SEC)</option>
          <option value="SR">Super Rare (SR)</option>
          <option value="R">Rare (R)</option>
          <option value="UC">Uncommon (UC)</option>
          <option value="C">Common (C)</option>
          <option value="SP">Special (SP)</option>
          <option value="P">Promo (P)</option>
        </select>
      </div>

      {% comment %} Volatility Index Widget {% endcomment %}
      <div class="price-index__volatility-widget" data-volatility-widget>
        <h3 class="price-index__widget-title">Volatility Index</h3>
        <div class="price-index__volatility-meter">
          <div class="price-index__volatility-gauge" data-volatility-gauge>
            <div class="price-index__volatility-fill" data-volatility-fill style="width: 0%"></div>
          </div>
          <div class="price-index__volatility-labels">
            <span>Stable</span>
            <span>Volatile</span>
          </div>
        </div>
        <div class="price-index__volatility-value" data-volatility-value>--</div>
        <div class="price-index__volatility-breakdown" data-volatility-breakdown>
          <div class="price-index__volatility-stat">
            <span class="price-index__volatility-stat-label">High Vol Cards</span>
            <span class="price-index__volatility-stat-value" data-high-vol-count>--</span>
          </div>
          <div class="price-index__volatility-stat">
            <span class="price-index__volatility-stat-label">Avg Movement</span>
            <span class="price-index__volatility-stat-value" data-avg-movement>--</span>
          </div>
        </div>
      </div>

      {% comment %} Top Movers Section {% endcomment %}
      <div class="price-index__movers">
        <h3 class="price-index__movers-title">Top Movers (24h)</h3>

        <div class="price-index__movers-tabs">
          <button type="button" class="price-index__movers-tab price-index__movers-tab--active" data-movers-tab="gainers">
            Gainers
          </button>
          <button type="button" class="price-index__movers-tab" data-movers-tab="losers">
            Losers
          </button>
          <button type="button" class="price-index__movers-tab" data-movers-tab="volume">
            Volume
          </button>
        </div>

        <div class="price-index__movers-list" data-movers-gainers>
          <div class="price-index__movers-loading">
            <div class="price-index-spinner"></div>
          </div>
        </div>

        <div class="price-index__movers-list" data-movers-losers hidden>
          <div class="price-index__movers-loading">
            <div class="price-index-spinner"></div>
          </div>
        </div>

        <div class="price-index__movers-list" data-movers-volume hidden>
          <div class="price-index__movers-loading">
            <div class="price-index-spinner"></div>
          </div>
        </div>
      </div>

      {% comment %} Price Alerts Section {% endcomment %}
      <div class="price-index__alerts" data-alerts-section>
        <div class="price-index__alerts-header">
          <h3 class="price-index__alerts-title">
            <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
              <path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zm0 16a3 3 0 01-3-3h6a3 3 0 01-3 3z"/>
            </svg>
            Price Alerts
          </h3>
          <button type="button" class="price-index__alerts-add-btn" data-add-alert-btn title="Add Alert">
            <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
              <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/>
            </svg>
          </button>
        </div>
        <div class="price-index__alerts-list" data-alerts-list>
          <div class="price-index__alerts-empty" data-alerts-empty>
            <p>No price alerts set</p>
            <p class="price-index__alerts-hint">Click + to add an alert for any card</p>
          </div>
        </div>
        <div class="price-index__alerts-triggered" data-alerts-triggered hidden>
          <div class="price-index__alerts-triggered-header">
            <span>Triggered Alerts</span>
            <button type="button" class="price-index__alerts-clear-btn" data-clear-triggered>Clear All</button>
          </div>
          <div class="price-index__alerts-triggered-list" data-triggered-list></div>
        </div>
      </div>
    </aside>
  </div>

  {% comment %} Add Alert Modal {% endcomment %}
  <div class="price-index__modal" data-alert-modal hidden>
    <div class="price-index__modal-backdrop" data-modal-close></div>
    <div class="price-index__modal-content">
      <div class="price-index__modal-header">
        <h3>Add Price Alert</h3>
        <button type="button" class="price-index__modal-close" data-modal-close>
          <svg viewBox="0 0 20 20" fill="currentColor" width="20" height="20">
            <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
          </svg>
        </button>
      </div>
      <div class="price-index__modal-body">
        <div class="price-index__form-group">
          <label class="price-index__form-label">Search Card</label>
          <input type="text" class="price-index__form-input" data-alert-search placeholder="Type card name..." autocomplete="off" />
          <div class="price-index__search-results" data-alert-search-results hidden></div>
        </div>
        <div class="price-index__form-group" data-selected-card-info hidden>
          <label class="price-index__form-label">Selected Card</label>
          <div class="price-index__selected-card" data-selected-card></div>
        </div>
        <div class="price-index__form-group">
          <label class="price-index__form-label">Alert Type</label>
          <select class="price-index__form-select" data-alert-type>
            <option value="above">Price goes above</option>
            <option value="below">Price goes below</option>
            <option value="change">Price changes by %</option>
          </select>
        </div>
        <div class="price-index__form-group">
          <label class="price-index__form-label">Target Value</label>
          <div class="price-index__form-input-group">
            <span class="price-index__form-prefix" data-alert-prefix>£</span>
            <input type="number" class="price-index__form-input" data-alert-value step="0.01" placeholder="0.00" />
          </div>
        </div>
      </div>
      <div class="price-index__modal-footer">
        <button type="button" class="price-index__modal-btn price-index__modal-btn--secondary" data-modal-close>Cancel</button>
        <button type="button" class="price-index__modal-btn price-index__modal-btn--primary" data-save-alert>Save Alert</button>
      </div>
    </div>
  </div>

  {% comment %} TCG-100 Index (NASDAQ-Style) {% endcomment %}
  <section class="tcg100-section">
    <div class="tcg100-section__header">
      <div>
        <div class="tcg100-section__title">
          TCG-100 Index
          <span class="tcg100-section__badge">NASDAQ-Style</span>
        </div>
        <div class="tcg100-section__subtitle">
          Market-cap weighted index with buffer zones and weight capping
        </div>
      </div>

      {% comment %} Language Toggle {% endcomment %}
      <div class="tcg100-language-toggle" data-tcg100-language-toggle>
        <button type="button" class="tcg100-language-btn tcg100-language-btn--active" data-language="ALL">
          All
        </button>
        <button type="button" class="tcg100-language-btn" data-language="EN">
          EN
        </button>
        <button type="button" class="tcg100-language-btn" data-language="JP">
          JP
        </button>
      </div>
    </div>

    {% comment %} EN vs JP Comparison - populated by JavaScript {% endcomment %}
    <div data-language-comparison></div>

    {% comment %} TCG-100 Summary - populated by JavaScript {% endcomment %}
    <div data-tcg100-summary>
      <div class="tcg100-summary">
        <div class="tcg100-summary__main">
          <div class="tcg100-summary__value-container">
            <div class="tcg100-summary__label">TCG-100 Index</div>
            <div class="tcg100-summary__value">Loading...</div>
          </div>
        </div>
      </div>
    </div>

    {% comment %} TCG-100 Constituents Table - populated by JavaScript {% endcomment %}
    <div class="tcg100-table-container" data-tcg100-table>
      <div class="price-index__summary-loading">
        <div class="price-index-spinner"></div>
        <span>Loading index constituents...</span>
      </div>
    </div>
  </section>

  {% comment %} Set Breakdown Table {% endcomment %}
  <section class="price-index__sets">
    <h2 class="price-index__sets-title">Set Performance</h2>
    <div class="price-index__sets-table-wrapper">
      <table class="price-index__sets-table">
        <thead>
          <tr>
            <th class="price-index__sets-th price-index__sets-th--sortable" data-sort="key">Set</th>
            <th class="price-index__sets-th price-index__sets-th--sortable price-index__sets-th--right" data-sort="cardCount">Cards</th>
            <th class="price-index__sets-th price-index__sets-th--sortable price-index__sets-th--right" data-sort="avgPrice">Avg Price</th>
            <th class="price-index__sets-th price-index__sets-th--sortable price-index__sets-th--right" data-sort="change24h">24h</th>
            <th class="price-index__sets-th price-index__sets-th--sortable price-index__sets-th--right" data-sort="change7d">7d</th>
            <th class="price-index__sets-th price-index__sets-th--sortable price-index__sets-th--right" data-sort="totalMarketCap">Market Cap</th>
            <th class="price-index__sets-th price-index__sets-th--right">Trend</th>
          </tr>
        </thead>
        <tbody data-sets-body>
          <tr>
            <td colspan="7" class="price-index__sets-loading">
              <div class="price-index-spinner"></div>
              <span>Loading set data...</span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</div>

